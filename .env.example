# Copy to .env and fill in. .env is git-ignored. Do not put a private key here:
# the scripts take the signer from a Foundry keystore (`cast wallet import`).

# --- Networks (testnets only) ---
REACTIVE_RPC=https://lasna-rpc.rnk.dev/
REACTIVE_CHAIN_ID=5318007
ORIGIN_RPC=https://sepolia.unichain.org
ORIGIN_CHAIN_ID=1301
DESTINATION_RPC=https://sepolia.unichain.org
DESTINATION_CHAIN_ID=1301

# --- Reactive infrastructure (public addresses from dev.reactive.network) ---
SYSTEM_CONTRACT_ADDR=0x8888888888888888888888888888888888888888
DESTINATION_CALLBACK_PROXY_ADDR=0x775c9B990ADe401060B78D0e98684eEf8d2466C1

# --- Funding sent with each deployment, in wei ---
# 1 lREACT for the reactive contract, 0.01 ETH for the callback contract.
REACTIVE_FUNDING_WEI=1000000000000000000
CALLBACK_FUNDING_WEI=10000000000000000

# --- OCO system (script/Oco.s.sol) ---
# Uniswap v4 PoolManager on Unichain Sepolia (developers.uniswap.org v4 deployments).
POOL_MANAGER_ADDR=0x00B036B58a818B1BC34d502D3fE730Db729e62AC
# 1 lREACT for the reactive contract, 0.002 ETH for the vault's callback fees.
OCO_REACTIVE_FUNDING_WEI=1000000000000000000
VAULT_FUNDING_WEI=2000000000000000
# Filled in as you deploy; leave empty until the matching script prints the value.
TOKEN0_ADDR=
TOKEN1_ADDR=
SWAPPER_ADDR=
OCO_REACTIVE_ADDR=
ORDER_VAULT_ADDR=

# --- Filled in as you deploy ---
# Leave empty until the matching script prints the address.
PING_ORIGIN_ADDR=
PING_REACTIVE_ADDR=
PONG_CALLBACK_ADDR=
